.version 6.0
.target sm_52
.address_size 64
.visible .entry k(.param .u64 pa)
{
  .reg .b32 %t; .reg .b64 %a,%o; .reg .f32 %f;
  ld.param.u64 %a,[pa]; cvta.to.global.u64 %a,%a;
  mov.u32 %t,%tid.x; cvt.rn.f32.u32 %f,%t; mul.f32 %f,%f,0f40000000;
  mul.wide.u32 %o,%t,4; add.u64 %a,%a,%o; st.global.f32 [%a],%f; ret;
}
