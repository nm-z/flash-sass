                 $paramSec->{ExitOffsets}  = \@exitOffsets;
@@ -479,7 +489,36 @@ sub modifyKernel
         $kernelSec->{flags} |=  $newBar << 20;
     }
 
+    # Drivers from CUDA 11 on take the register count from EIATTR_REGCOUNT (0x2f04)
+    # in the global .nv.info section, keyed by the kernel's symbol index, not from
+    # the section header. Keep it in step or the kernel launches with the old count.
+    if (my $info = $cubin->{'.nv.info'})
+    {
+        my $symTab = $cubin->{'.symtab'}{SymTab};
+        my $symIdx = -1;
+        foreach my $i (0 .. $#$symTab)
+        {
+            $symIdx = $i if $symTab->[$i] == $kernelSec->{SymbolEnt};
+        }
+        my @d = unpack "L*", pack "H*", $info->{Data};
+        my $i = 0;
+        while ($i < @d)
+        {
+            my $code = $d[$i] & 0xffff;
+            my $size = $d[$i] >> 16;
+            $i++;
+            if ($code == 0x2f04 && $d[$i] == $symIdx && $d[$i+1] != $newReg)
+            {
+                print "Modified $kernelName EIATTR_REGCOUNT: $d[$i+1] => $newReg\n";
+                $d[$i+1] = $newReg;
+            }
+            $i += $size / 4 if ($code & 0xff) == 0x04;
+        }
+        $info->{Data} = unpack "H*", pack "L*", @d;
+    }
+
     my @paramData = @{$paramSec->{StaticParams}};
+    push @paramData, @{$paramSec->{Unknown} || []};
 
     if (defined $maxregCount)
     {
