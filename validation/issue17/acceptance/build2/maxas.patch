-                        printf STDERR "Unknown Code 0x%02x (size:%d)\n", $code, $size;
+                        # Keep attributes this assembler does not know (newer ptxas emits
+                        # several) and skip their payload so the scan stays aligned.
+                        # EIFMT_SVAL (low byte 0x04) carries $size bytes; NVAL/HVAL carry none.
+                        push @unknown, ($size << 16) | $code;
+                        if (($code & 0xff) == 0x04)
