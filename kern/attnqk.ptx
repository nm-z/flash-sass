// Skeleton for MaxAs: same entry name and parameter layout as attnqk.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry attnqk(.param .u64 pq, .param .u64 pk, .param .u64 pv, .param .u64 pqn, .param .u64 pkn, .param .u64 pcs, .param .u64 psn, .param .u64 pqo, .param .u64 pkc, .param .u64 pvc, .param .u32 t, .param .f32 eps)
{
	.reg .u32 %r<2>;
	.reg .f32 %f<1>;
	.reg .pred %p;
	ld.param.f32 %f0, [eps];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r1;
	@%p ret;
	ret;
}
