[Unit]
Description=Slot 4 PCIe link (card 3, dies 4 and 5) at gen2: it makes thousands of errors per token at gen3
After=basic.target
Before=gpu-application-clocks.service
ConditionPathExists=/sys/bus/pci/devices/0000:00:03.0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pcie-slot4-gen2.sh 00:03.0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
