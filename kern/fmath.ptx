// Skeleton for MaxAs: same entry name and parameter layout as fmath.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry fmath(.param .u64 px, .param .u64 pe, .param .u64 ps, .param .u64 pl, .param .u64 pp)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r1;
	@%p ret;
	ret;
}
