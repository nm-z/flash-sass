// Skeleton for MaxAs: same entry name and parameter layout as actq.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry actq(.param .u64 px, .param .u64 pq, .param .u64 ps32, .param .u64 ps16, .param .u64 psc, .param .u32 n)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	ld.param.u32 %r0, [n];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r0;
	@%p ret;
	ret;
}
