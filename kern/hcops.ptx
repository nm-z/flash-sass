// Skeleton for MaxAs: same entry name and parameter layout as hcops.sass (all three ops).
.version 7.4
.target sm_52
.address_size 64

.visible .entry hcops(.param .u64 p0, .param .u64 p1, .param .u64 p2, .param .u32 n)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	ld.param.u32 %r0, [n];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r0;
	@%p ret;
	ret;
}
