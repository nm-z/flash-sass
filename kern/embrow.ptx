// Skeleton for MaxAs: same entry name and parameter layout as embrow.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry embrow(.param .u64 pe, .param .u64 ps, .param .u32 id, .param .u64 pids)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	ld.param.u32 %r0, [id];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r0;
	@%p ret;
	ret;
}
