// Skeleton for MaxAs: same entry name and parameter layout as mailbox.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry mailbox(.param .u64 lseq, .param .u64 rseq, .param .u64 lpay, .param .u64 rpay, .param .u32 iters, .param .u32 role, .param .u64 pout)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	ld.param.u32 %r0, [iters];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r0;
	@%p ret;
	ret;
}
