// Skeleton for MaxAs: same entry name and parameter layout as gridbar.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry gridbar(.param .u64 pctr, .param .u64 pgen, .param .u32 nctas, .param .u32 iters, .param .u64 pout, .param .u64 pdata)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	ld.param.u32 %r0, [nctas];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r0;
	@%p ret;
	ret;
}
