.version 7.4
.target sm_52
.address_size 64
.visible .entry flash_exact_batch_abi_v1() { ret; }
.visible .entry flash_gr_read_sum_abi_v1() { ret; }
.visible .entry flash_phase_fused_abi_v1() { ret; }
.visible .entry flash_phase_fused_abi_v2() { ret; }
.visible .entry flash_phase_fused_abi_v3() { ret; }
.visible .entry flash_phase_fused_abi_v4() { ret; }
.visible .entry flash_phase_fused_abi_v5() { ret; }
.visible .entry flash_phase_fused_abi_v6() { ret; }
.visible .entry flash_phase_exchange_join_abi_v1() { ret; }
.visible .entry flash_phase_gr_cache_abi_v1() { ret; }
.visible .entry flash_phase_amax_schedule_abi_v1() { ret; }
.visible .entry flash_qsa_score_epoch_abi_v1() { ret; }
.visible .entry flash_fused_moe_abi_v1() { ret; }
.visible .entry die(.param .u64 pprog, .param .u32 nph, .param .u64 pctl, .param .u32 ntok)
{
    .shared .align 16 .b8 smem[49152];
    .reg .u32 %r<2>;
    .reg .pred %p;
    ld.param.u32 %r0, [nph];
    mov.u32 %r1, %tid.x;
    bar.sync 0;
    bar.sync 1;
    setp.lt.u32 %p, %r1, %r0;
    @%p ret;
    ret;
}
