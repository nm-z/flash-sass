// Skeleton for MaxAs: same entry name and parameter layout as router.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry router(.param .u64 pr, .param .u64 psh, .param .u64 pidx, .param .u64 pw, .param .u64 ps)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r1;
	@%p ret;
	ret;
}
