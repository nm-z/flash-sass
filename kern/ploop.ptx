.version 7.4
.target sm_52
.address_size 64
.visible .entry ploop(.param .u64 po, .param .u32 pn)
{
	.reg .u64 %o, %a; .reg .u32 %i, %n, %v; .reg .pred %p;
	ld.param.u64 %o, [po]; ld.param.u32 %n, [pn]; cvta.to.global.u64 %o, %o;
	mov.u32 %i, 0; mov.u32 %v, 7;
L:
	mul.wide.u32 %a, %i, 4; add.u64 %a, %o, %a;
	st.global.u32 [%a], %v;
	mad.lo.u32 %v, %v, 3, 1;
	add.u32 %i, %i, 1;
	setp.lt.u32 %p, %i, %n;
	@%p bra L;
	ret;
}
