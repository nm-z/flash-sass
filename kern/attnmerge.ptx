// Skeleton for MaxAs: same entry name and parameter layout as attnmerge.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry attnmerge(.param .u64 ppm, .param .u64 ppd, .param .u64 ppo, .param .u64 pgate, .param .u64 pout)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p, %r1, %r1;
	@%p ret;
	ret;
}
