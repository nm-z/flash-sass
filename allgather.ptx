// Skeleton for MaxAs: same entry name and parameter layout as allgather.sass.
.version 7.4
.target sm_52
.address_size 64

.visible .entry allgather(.param .u64 pt, .param .u64 ft, .param .u32 me, .param .u32 iters, .param .u64 out)
{
	.reg .u32 %r<2>;
	.reg .pred %p;
	ld.param.u32 %r0, [iters];
	mov.u32 %r1, %tid.x;
	bar.sync 0;
	setp.lt.u32 %p, %r1, %r0;
	@%p ret;
	ret;
}
